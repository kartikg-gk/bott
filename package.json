{
  "name": "bott",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "bott": "dist/src/bin.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "vercel-build": "npm run build && node -e \"require('node:fs').mkdirSync('public',{recursive:true})\"",
    "start": "node dist/src/bin.js run",
    "mem0:check": "tsx scripts/mem0-check.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "mem0ai": "^3.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@daytonaio/sdk": "^0.232.0",
    "@qdrant/js-client-rest": "^1.20.0",
    "better-sqlite3": "^13.2.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "mem0ai": {
      "better-sqlite3": "$better-sqlite3"
    }
  }
}
