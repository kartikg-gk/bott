# Settings for bott. Copy this file to .env for `bott run` on this machine, or set the same
# variables in the host's environment. Leave a value empty to use its default.

# 1 when serving as a hosted function; automatic on Vercel
BOTT_HOSTED=

# Address the local server listens on
BOTT_HOST=127.0.0.1

# Port the local server listens on
BOTT_PORT=8765

# Folder for bot files, sessions and the local database
BOTT_STATE_DIR=

# The chief bot's working folder; <state>/workspace if unset
BOTT_PROJECT_DIR=

# SQLite file when D1 is not configured
BOTT_DATABASE=

# 32 hex characters naming this deployment; required hosted
BOTT_INSTANCE=

# Person id the page acts for in token mode
BOTT_ACTOR=1

# token (one person, local only) or google; google when hosted
BOTT_AUTH=

# Token for the page in token mode, 16 characters or more
BOTT_WEB_TOKEN=

# 32 random bytes as base64; seals saved keys and tokens
BOTT_MASTER_KEY=

# Public origin of the page, such as https://bott.example.com
BOTT_ORIGIN=

# Google OAuth client for sign-in
BOTT_GOOGLE_CLIENT_ID=

# Google OAuth client secret for sign-in
BOTT_GOOGLE_CLIENT_SECRET=

# Comma-separated addresses that may sign in
BOTT_ALLOWED_EMAILS=

# Comma-separated Workspace domains that may sign in
BOTT_ALLOWED_DOMAINS=

# Secret a trusted proxy sends in X-Bott-Proxy
BOTT_PROXY_SECRET=

# openai, anthropic or openrouter, for token mode
BOTT_PROVIDER=

# Model name sent to that provider
BOTT_MODEL=

# OpenAI key; also used for memory embeddings
OPENAI_API_KEY=

# Another OpenAI-compatible endpoint for embeddings
OPENAI_BASE_URL=

# Anthropic key for token mode
ANTHROPIC_API_KEY=

# OpenRouter key for token mode
OPENROUTER_API_KEY=

# engine, ask, deny or auto: how tool calls are approved
BOTT_POLICY=

# Seconds before an idle session is closed
BOTT_IDLE_SECONDS=1800

# Seconds an approval waits
BOTT_APPROVAL_SECONDS=300

# Most runs or jobs at once
BOTT_WORKERS=

# Langfuse address to send run traces to (names, counts and timings only); off when empty
BOTT_LANGFUSE_URL=

# Langfuse public key, with BOTT_LANGFUSE_URL
BOTT_LANGFUSE_PUBLIC_KEY=

# Langfuse secret key, with BOTT_LANGFUSE_URL
BOTT_LANGFUSE_SECRET_KEY=

# How hard models think before answering: off, minimal, low, medium, high, xhigh or max
BOTT_THINKING=

# Days kept of finished message text, chat history and run records
BOTT_RETENTION_DAYS=7

# Seconds running work may take to end when the server stops
BOTT_STOP_SECONDS=30

# local, docker or daytona: where bots run commands
BOTT_EXECUTOR=

# Image for bot containers
BOTT_DOCKER_IMAGE=

# Memory cap for bot containers
BOTT_DOCKER_MEMORY=2g

# Daytona region
BOTT_DAYTONA_TARGET=

# Daytona snapshot for new sandboxes
BOTT_DAYTONA_SNAPSHOT=

# Idle minutes before a sandbox is archived
BOTT_DAYTONA_ARCHIVE_MINUTES=

# open or closed network for containers and sandboxes
BOTT_SANDBOX_NETWORK=

# Daytona key, when the executor is daytona
DAYTONA_API_KEY=

# Model requests one run may send
BOTT_REQUESTS_PER_RUN=100

# Model requests per UTC day
BOTT_REQUESTS_PER_DAY=1000

# Spend cap per run, in millionths of a dollar
BOTT_SPEND_MICROS_PER_RUN=

# Spend cap per UTC day, in millionths of a dollar
BOTT_SPEND_MICROS_PER_DAY=

# JSON: most one attempt may cost, {"provider/model": n}
BOTT_ATTEMPT_MAX_MICROS=

# on to recall long-term memory (not hosted)
BOTT_MEMORY=off

# on to learn facts after each exchange
BOTT_MEMORY_EXTRACT=off

# Qdrant server for the memory index
BOTT_QDRANT_URL=

# Qdrant key, when the server needs one
QDRANT_API_KEY=

# Embedding model for memory
BOTT_EMBEDDING_MODEL=

# Cloudflare D1; all three switch storage to D1
CLOUDFLARE_API_TOKEN=

# Cloudflare D1; all three switch storage to D1
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare D1; all three switch storage to D1
CLOUDFLARE_D1_DATABASE_ID=

# OAuth client for the github app
BOTT_GITHUB_CLIENT_ID=

# OAuth secret for the github app
BOTT_GITHUB_CLIENT_SECRET=

# OAuth client for the gmail app
BOTT_GMAIL_CLIENT_ID=

# OAuth secret for the gmail app
BOTT_GMAIL_CLIENT_SECRET=

# OAuth client for the calendar app
BOTT_CALENDAR_CLIENT_ID=

# OAuth secret for the calendar app
BOTT_CALENDAR_CLIENT_SECRET=

# OAuth client for the drive app
BOTT_DRIVE_CLIENT_ID=

# OAuth secret for the drive app
BOTT_DRIVE_CLIENT_SECRET=

# OAuth client for the contacts app
BOTT_CONTACTS_CLIENT_ID=

# OAuth secret for the contacts app
BOTT_CONTACTS_CLIENT_SECRET=

# OAuth client for the notion app
BOTT_NOTION_CLIENT_ID=

# OAuth secret for the notion app
BOTT_NOTION_CLIENT_SECRET=

# OAuth client for the linear app
BOTT_LINEAR_CLIENT_ID=

# OAuth secret for the linear app
BOTT_LINEAR_CLIENT_SECRET=

# OAuth client for the todoist app
BOTT_TODOIST_CLIENT_ID=

# OAuth secret for the todoist app
BOTT_TODOIST_CLIENT_SECRET=

# GitHub token for the github app without OAuth
BOTT_GITHUB_TOKEN=

# Gmail refresh token for the gmail app without OAuth
BOTT_GMAIL_REFRESH_TOKEN=

# Telegram bot that sends messages for bots
BOTT_TELEGRAM_APP_TOKEN=

# Tavily key for web search
BOTT_TAVILY_API_KEY=

# Exa key for web search
BOTT_EXA_API_KEY=

# ScraperAPI key for reading pages
BOTT_SCRAPERAPI_API_KEY=
