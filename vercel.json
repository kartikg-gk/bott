{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "fluid": true,
  "functions": {
    "api/index.js": { "maxDuration": 300 }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
